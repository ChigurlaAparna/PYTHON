lst1=list(map(int,input("Enter the list:").split()))
lst2=list(map(int,input("Enter the list:").split()))
merged=[]
for i in lst1:
    merged.append(i)
for i in lst2:
    merged.append(i)
unique=[]
for i in merged:
    if i not in unique:
        unique.append(i)
for i in range(len(unique)):
    for j in range(i+1,len(unique)):
        if unique[i]>unique[j]:
            temp=unique[i]
            unique[i]=unique[j]
            unique[j]=temp
print("Merged list in ascending order:",unique)

